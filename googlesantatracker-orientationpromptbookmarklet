(function(){(function () {
  function isiOSPermissionRequired() {
    return (
      typeof DeviceMotionEvent !== "undefined" &&
      typeof DeviceMotionEvent.requestPermission === "function"
    );
  }

  function requestPermissions() {
    Promise.all([
      DeviceMotionEvent.requestPermission(),
      DeviceOrientationEvent.requestPermission()
    ])
      .then(([motion, orientation]) => {
        console.log("Motion:", motion, "Orientation:", orientation);

        if (motion === "granted" || orientation === "granted") {
          window.dispatchEvent(new Event("motion-permission-granted"));
        }
      })
      .catch(err => console.error(err));
  }

  function createFullscreenTapLayer() {
    const overlay = document.createElement("div");

    overlay.style.position = "fixed";
    overlay.style.top = "0";
    overlay.style.left = "0";
    overlay.style.width = "100vw";
    overlay.style.height = "100vh";
    overlay.style.zIndex = "999999";
    overlay.style.background = "rgba(0,0,0,0)"; // fully transparent
    overlay.style.touchAction = "manipulation";
    overlay.style.cursor = "pointer";

    overlay.addEventListener(
      "click",
      () => {
        requestPermissions();
        overlay.remove();
      },
      { once: true }
    );

    document.body.appendChild(overlay);
  }

  window.addEventListener("load", () => {
    if (isiOSPermissionRequired()) {
      createFullscreenTapLayer();
    } else {
      window.dispatchEvent(new Event("motion-permission-granted"));
    }
  });
})();})();
